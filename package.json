{
  "name": "pagesmith-pdf",
  "version": "0.1.0",
  "description": "Lokale PDF-Werkzeuge fuer Windows 11",
  "author": "PageSmith PDF",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/backend/job-runner.js && node --check src/preload.js && node --check src/renderer/config.js && node --check src/renderer/app.js",
    "test": "node test/core.test.js",
    "dist": "electron-builder --win nsis"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "dependencies": {
    "docx": "^9.5.1",
    "marked": "^15.0.7",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.2.108"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "de.lokalpdf.werkstatt",
    "productName": "PageSmith PDF",
    "icon": "src/pagesmith-mark.ico",
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/pdfjs-dist/build/**/*",
      "!node_modules/pdfjs-dist/web/**/*",
      "!node_modules/pdfjs-dist/types/**/*",
      "!node_modules/pdfjs-dist/test/**/*",
      "!node_modules/pdfjs-dist/**/*.map",
      "!node_modules/pdfjs-dist/**/*.md"
    ],
    "win": {
      "target": "nsis",
      "electronLanguages": [
        "de",
        "en-US"
      ],
      "compression": "maximum",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
